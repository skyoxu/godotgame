{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "godot-project-knowledge/knowledge-consumption-decision-set.v2",
  "type": "object",
  "required": ["decisions"],
  "properties": {
    "decisions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "accepted", "reason", "satisfies"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "accepted": {"type": "boolean"},
          "reason": {"type": "string", "minLength": 1},
          "satisfies": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
