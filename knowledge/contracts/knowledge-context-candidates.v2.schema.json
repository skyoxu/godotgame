{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "godot-project-knowledge/knowledge-context-candidates.v2",
  "type": "object",
  "required": ["schema", "consumer", "revision", "publication_state", "status", "candidates", "bundle_sha256"],
  "properties": {
    "schema": {"const": "godot-project-knowledge.context-candidates.v2"},
    "consumer": {"enum": ["repository-session", "chapter4", "chapter5", "chapter6", "review"]},
    "task_id": {"type": ["string", "null"]},
    "revision": {"type": ["string", "null"]},
    "policy_revision": {"type": ["string", "null"]},
    "publication_state": {"enum": ["published-current", "ephemeral"]},
    "status": {"enum": ["ready", "fallback_required"]},
    "semantic_decision_required": {"type": "boolean"},
    "freeze_state": {"const": "unfrozen"},
    "candidates": {"type": "array", "items": {"type": "object", "required": ["path", "semantic_satisfaction"], "properties": {"path": {"type": "string"}, "source_sha256": {"type": "string"}, "semantic_satisfaction": {"const": "undecided"}}}},
    "bundle_sha256": {"type": "string", "minLength": 64, "maxLength": 64}
  },
  "additionalProperties": true
}
