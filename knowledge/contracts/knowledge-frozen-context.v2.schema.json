{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "godot-project-knowledge/knowledge-frozen-context.v2",
  "type": "object",
  "required": ["schema", "consumer", "revision", "candidate_bundle_sha256", "decisions", "accepted_paths", "frozen_sha256"],
  "properties": {
    "schema": {"const": "godot-project-knowledge.frozen-context.v2"},
    "consumer": {"enum": ["repository-session", "chapter4", "chapter5", "chapter6", "review"]},
    "task_id": {"type": ["string", "null"]},
    "revision": {"type": ["string", "null"]},
    "publication_state": {"type": ["string", "null"]},
    "candidate_bundle_sha256": {"type": "string"},
    "decisions": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["path", "accepted", "reason", "satisfies", "source"], "properties": {"path": {"type": "string"}, "accepted": {"type": "boolean"}, "reason": {"type": "string", "minLength": 1}, "satisfies": {"type": "string", "minLength": 1}, "source": {"type": "object"}}}},
    "accepted_paths": {"type": "array", "items": {"type": "string"}},
    "frozen_sha256": {"type": "string", "minLength": 64, "maxLength": 64}
  },
  "additionalProperties": true
}
